####################################
# 📝  Global ignores (OS / editors)
####################################
.DS_Store
Thumbs.db
*.swp
*~

# IDE / editor folders
.vscode/
.idea/
*.sublime-*

####################################
# 🔧  NestJS build artefacts (scoped)
####################################
# Dependencies
/beautyn-api/node_modules/

# Compiled output (Nest CLI)
/beautyn-api/dist/

# Test coverage
/beautyn-api/coverage/
/beautyn-api/.nyc_output/

# Logs & runtime files
/beautyn-api/*.log
/beautyn-api/logs/
/beautyn-api/pids/
/beautyn-api/*.pid

# NestJS CLI cache & generated docs
/beautyn-api/.nestjs/
/beautyn-api/swagger-static/

# Prisma
# local SQLite
/beautyn-api/prisma/dev.db
# SQLite WAL files
/beautyn-api/prisma/*.db-journal
# generated client cache (if any)
/beautyn-api/.prisma/

####################################
# 🔐  Environment & secrets (scoped)
/beautyn-api/.env*
!beautyn-api/.env.example
# root-level .env (if you create one)
.env*

####################################
# 🤖  Claude Code (machine-local overrides)
####################################
/beautyn-api/.claude/settings.local.json

####################################
# 📦  Package-manager lockfiles (scoped)
/beautyn-api/package-lock.json
/beautyn-api/yarn.lock
/beautyn-api/pnpm-lock.yaml

####################################
# 🛠️  Misc temp files
*.tmp
tmp/
temp/

####################################
# 🕸️  Graphify (keep only what `graphify query` needs: graph.json,
#     manifest.json, .graphify_labels.json, GRAPH_REPORT.md)
####################################
# dated pre-update backups (graphify update snapshots the curated graph)
/beautyn-api/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# regenerable viz (graphify export html)
/beautyn-api/graphify-out/graph.html
# local extraction cache
/beautyn-api/graphify-out/cache/
# local token telemetry
/beautyn-api/graphify-out/cost.json
# machine-specific interpreter path + scan root
/beautyn-api/graphify-out/.graphify_python
/beautyn-api/graphify-out/.graphify_root
/beautyn-api/graphify-out/.graphify_detect.json
/beautyn-api/graphify-out/.graphify_extract.json
/beautyn-api/graphify-out/.graphify_ast.json
/beautyn-api/graphify-out/.graphify_semantic.json
/beautyn-api/graphify-out/.graphify_analysis.json
/beautyn-api/graphify-out/.graphify_chunk_*.json
/beautyn-api/graphify-out/.graphify_uncached.txt
/beautyn-api/graphify-out/.graphify_cached.json
/beautyn-api/graphify-out/.needs_update

###############################################################################
# Supabase CLI (local containers, caches, temp files)  ─── stored in /beautyn-api
###############################################################################
# runtime state from `supabase start`
/beautyn-api/.supabase/
# CLI download / build cache
/beautyn-api/supabase/.temp/
# auto-generated docker-compose / env
/beautyn-api/supabase/docker/**
/beautyn-api/supabase/backups/
/beautyn-api/supabase/dump*.sql
# ad-hoc pg_dump exports
/beautyn-api/*.dump.sql
/beautyn-api/.claude/settings.json
# agent worktrees and local claude state at repo root
/.claude/
